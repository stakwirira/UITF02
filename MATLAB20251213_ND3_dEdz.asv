%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% SCRIPT_NAME: ND3_dEdz_Profile.m
% -------------------------------------------------------------------------
% AUTHOR: SAMUEL KHUMBULA
% DATE CREATED: 2025-11-25
% LAST MODIFIED: 2025-12-13
% VERSION: 1.0
% -------------------------------------------------------------------------
% DESCRIPTION: 
% This script processes and plots a 1D longitudinal depth dose profile 
% (Dose vs. Depth Z). It reads linear dose data from a CSV file, 
% converts the bin index to physical depth in centimeters, and generates 
% a highly-styled line plot. It also automatically calculates and 
% annotates the location and value of the peak dose for electrons while 
% irradiating ND3 target. The CSV file is generated by TOPAS simulation.
% -------------------------------------------------------------------------
% INPUTS: 
%   'ND3 dEdz Profile' - CSV file containing dose data vs. Z-index.
% OUTPUTS: 
%   Figure 1 - Longitudinal Depth Dose Profile plot.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

clc; clear; close all;

%% 1. Parameters
filename = '20260127ND3dEdz.csv'; 
z_bin_width = 0.1; % cm (From the header: "# Z in 100 bins of 0.1 cm")

%% 2. Import Data
try
    raw_data = readmatrix(filename, 'NumHeaderLines', 8);
catch
    error('File not found. Make sure "%s" is in the current folder.', filename);
end

%% 3. Extract and Process Data
z_index = raw_data(:, 3);
dose_values = raw_data(:, 4);
depth_cm = (z_index * z_bin_width) + (z_bin_width / 2);

%% 4. Plotting
figure('Color', 'w');

% --- COLOR DEFINITIONS ---
uiColor = [0, 0, 1];    % Blue for Axes, Text, and Box
lineColor = [0, 0.7, 0]; % Green ONLY for the data line
% -------------------------

% Plotting only ONE smooth GREEN line (no markers)
plot(depth_cm, dose_values, '-', ...
    'Color', lineColor, ...   
    'LineWidth', 2);                

% --- APPLY UI STYLING (Blue) ---
ax = gca;
ax.FontSize = 12;
ax.FontWeight = 'bold';
ax.LineWidth = 1.5;
ax.XColor = uiColor;    % Axis line and numbers remain Blue
ax.YColor = uiColor;    % Axis line and numbers remain Blue
ax.GridColor = uiColor; % Grid remains Blue
ax.GridAlpha = 0.2;         

title('Longitudinal Depth Dose Profile (ND3 Target)', 'Color', uiColor, 'FontSize', 14);
xlabel('Depth Z (cm)', 'Color', uiColor, 'FontWeight', 'bold');
ylabel('Dose (Gy)', 'Color', uiColor, 'FontWeight', 'bold');
grid on;

% Add a text box with the Peak Dose info
[max_dose, max_idx] = max(dose_values);
peak_depth = depth_cm(max_idx);
stats_str = sprintf('Peak Dose: %.2e Gy\nAt Depth: %.1f cm', max_dose, peak_depth);

% Styled Annotation Box (Blue border and text)
annotation('textbox', [0.6, 0.75, 0.1, 0.1], ...
    'String', stats_str, ...
    'FitBoxToText', 'on', ...
    'BackgroundColor', 'white', ...
    'EdgeColor', uiColor, ...   
    'Color', uiColor, ...       
    'FontWeight', 'bold', ...
    'LineWidth', 1);

xlim([min(depth_cm) max(depth_cm)]);